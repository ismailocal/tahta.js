{
  "name": "tahta.js",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && npm run test:consumer",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "tsc -p fixtures/consumer/tsconfig.json && node fixtures/consumer/runtime.mjs",
    "start": "python3 -m http.server 3000",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "6.2.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0",
    "perfect-freehand": "^1.2.2",
    "roughjs": "^4.6.6",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.4.3"
  }
}
